<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 仅用于同一 Wi-Fi 下的局域网同步（手机与手机之间）与更新检查 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 应用内下载新版本后交给系统安装器；不申请则只能停在下载完成那一步 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- 蓝牙体脂秤：Android 12+ 用「附近设备」，更早的版本扫描 BLE 需要位置权限 -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />

    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".WorkoutActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".LibraryActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".OnboardActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".PlanActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".DiscoverActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ReportActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="portrait" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="portrait" />

        <activity
            android:name=".DayDetailActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ResultActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".StreakActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".BodyActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ScaleActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".SyncActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".WorkoutSettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".SelfTestActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".GeneralSettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".VoiceSettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ReminderActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ReminderEditActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ChallengeActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".AchievementsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".TemplatesActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".PickActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <receiver
            android:name=".ReminderReceiver"
            android:exported="false" />

        <receiver
            android:name=".StreakWidgetProvider"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_streak_info" />
        </receiver>

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!--
          更新包的出口。安装器在另一个进程里读文件，file:// 会被 FileUriExposedException 拦下，
          所以走内容提供者：不导出、只授临时读权限、只认缓存目录里的 update.apk。
        -->
        <provider
            android:name=".ApkProvider"
            android:authorities="${applicationId}.apk"
            android:exported="false"
            android:grantUriPermissions="true" />

  </application>

  <!--
    Android 11 起默认看不到别的应用。语音要在默认引擎缺中文时退到系统里
    其它 TTS 引擎，就必须声明能查询 TTS 服务，否则 queryIntentServices
    永远返回空，等于放弃了这条路。
  -->
  <queries>
    <intent>
      <action android:name="android.intent.action.TTS_SERVICE" />
    </intent>
    <!-- 同理：看不到安装器，startActivity 会直接抛 ActivityNotFoundException -->
    <intent>
      <action android:name="android.intent.action.VIEW" />
      <data android:mimeType="application/vnd.android.package-archive" />
    </intent>
  </queries>

</manifest>
