<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="0"
            android:textColor="#1C212C"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_streak_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_marginBottom="3dp"
            android:includeFontPadding="false"
            android:text="天连续"
            android:textColor="#888888"
            android:textSize="12sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/w_week"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:includeFontPadding="false"
            android:text="本周 0/4"
            android:textColor="#004AFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/w_dot0"
            android:layout_width="0dp"
            android:layout_height="7dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:background="@drawable/widget_dot_off"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/w_dot1"
            android:layout_width="0dp"
            android:layout_height="7dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:background="@drawable/widget_dot_off"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/w_dot2"
            android:layout_width="0dp"
            android:layout_height="7dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:background="@drawable/widget_dot_off"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/w_dot3"
            android:layout_width="0dp"
            android:layout_height="7dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:background="@drawable/widget_dot_off"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/w_dot4"
            android:layout_width="0dp"
            android:layout_height="7dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:background="@drawable/widget_dot_off"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/w_dot5"
            android:layout_width="0dp"
            android:layout_height="7dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:background="@drawable/widget_dot_off"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/w_dot6"
            android:layout_width="0dp"
            android:layout_height="7dp"
            android:layout_weight="1"
            android:background="@drawable/widget_dot_off"
            android:contentDescription="@null" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_today"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="今天：臀腿 · 16 分钟"
        android:textColor="#666666"
        android:textSize="12sp" />
</LinearLayout>
