<?xml version="1.0" encoding="utf-8"?>
<!--
  明文只留给手机间的局域网同步：两台手机在同一 Wi-Fi 下用 HTTP 交换数据（端口 8766）。
  更新检查走 https://apps.01iot.top，不需要放开明文，也不会回落到 HTTP。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- 更新接口强制走 TLS，即使哪天代码写错成 http:// 也连不上 -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">01iot.top</domain>
    </domain-config>
</network-security-config>
